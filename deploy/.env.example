# Satu file .env untuk VPS: docker-compose membaca ini otomatis untuk variable
# substitution (DOMAIN, IMAGE_TAG) DAN meneruskannya sebagai env container `api`
# (lewat env_file) — copy ke deploy/.env di VPS, isi nilai asli, jangan commit.

# Compose-level
DOMAIN=app.azerakol.id
IMAGE_TAG=latest

# Runtime server/src/config/env.ts
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://app.azerakol.id
DEFAULT_TENANT_SLUG=azerakol
MONGODB_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WA_NUMBER=081919525186
AI_TEXT_PROVIDER=deepseek
AI_VISION_PROVIDER=gemini
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
